# Create an Azure Translator single-service resource, select Free F0.
# Get key and region from Keys and Endpoint in Azure Portal.
# Import this file after replacing the placeholder; then verify the imported key
# in Q Translate > Dich vu & model > Alt+C > Kiem tra key da import.
# Do not send real keys in chat or commit/share this file after filling it.
AZURE_TRANSLATOR_KEY=replace_with_your_translator_resource_key
AZURE_TRANSLATOR_REGION=global
# Optional additional key/resource:
# AZURE_TRANSLATOR_KEY_2=another_translator_resource_key
# AZURE_TRANSLATOR_REGION_2=southeastasia
